# Backend environment. Copy to .env and fill in. NEVER commit .env — it holds real credentials.
#
#   copy .env.example .env        (cmd.exe)
#   Copy-Item .env.example .env   (PowerShell)

# --- Database -----------------------------------------------------------------------------------
# MySQL/MariaDB by default — works with XAMPP's bundled MySQL out of the box. XAMPP's default
# `root` account has no password, so this needs no changes if MySQL is started in the XAMPP
# Control Panel and nothing else has been customised.
DATABASE_URL="mysql://root@127.0.0.1:3306/yourstore_dev"

# `npm run db:create` creates the database above (idempotent, utf8mb4, never drops existing data).
# `npm run db:password` rewrites this line interactively if your MySQL root account needs a password,
# or if you are connecting to a different server.

# To use PostgreSQL instead (the schema also runs there — switch provider in prisma/schema.prisma
# and remove the `@db.Text` attributes, which are MySQL/Postgres-specific, or leave them: Postgres
# accepts @db.Text too):
#   DATABASE_URL="postgresql://user:password@localhost:5432/yourstore_dev?schema=public"

# To use SQLite instead (no server at all — remove every `@db.Text` attribute first, SQLite does not
# support native type annotations):
#   DATABASE_URL="file:./dev.db"

# --- Server -------------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Origins allowed to call this API with credentials (comma separated).
# Storefront runs on 5173, admin on 5174; the preview servers use 4173 / 4174.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174"

# Reverse-proxy hops to trust for the client IP (X-Forwarded-For), used by per-IP rate limits.
# false = no proxy (local dev, or this process terminates TLS itself). Behind exactly one proxy
# (nginx, a load balancer) set 1. Never "true" on a host reachable directly: clients could then
# spoof X-Forwarded-For and bypass per-IP limits.
TRUST_PROXY=false

# Public base URL of this API. Used to build absolute image URLs that work from both apps.
PUBLIC_API_URL="http://localhost:4000"

# --- Owner authentication -----------------------------------------------------------------------
# Secret used to sign the session cookie. Generate your own, keep it out of source control:
#   PowerShell:  [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET="CHANGE_ME_to_a_long_random_string"
# How long an owner session lasts.
SESSION_TTL_HOURS=12

# --- Seeded owner account -------------------------------------------------------------------------
# The seed creates this single owner ONLY if no owner with this email exists yet — it never
# overwrites an existing owner's stored password or name on a later re-seed. Change the password
# before exposing this API anywhere.
OWNER_EMAIL="owner@yourstore.example"
OWNER_PASSWORD="AdminDemo2026"
OWNER_NAME="Store Owner"

# --- Optional demo/sample seeding ----------------------------------------------------------------
# Both default OFF so a routine `npm run db:seed` on a real store never creates a demo shopper
# account or sample products. Turn these on only for local development/demos.
# SEED_DEMO_CUSTOMER=1   # creates demo@yourstore.example / DemoPass123
# SEED_SAMPLE_CATALOG=1  # creates the 4 sample categories, 20 sample products, homepage demo
                         # content, sample nav links and example collections
