# Your Store / Dignity ArtEdge — backend environment
# Copy to `.env` and fill in:  cp .env.example .env
# NEVER commit a real `.env`, and NEVER put real secrets in this file — every value
# below is a safe placeholder. The server validates this file at startup (see
# src/shared/config/env.ts) and refuses to start with an invalid environment.
# In production OWNER_PASSWORD must be set explicitly (no default is allowed).

# --- Database (required) -------------------------------------------------------------
# MySQL only. Development database URL (Aiven dev DB); production gets its own fresh DB.
DATABASE_URL=mysql://user:password@host:3306/database
DATABASE_CONNECTION_LIMIT=1
DATABASE_POOL_TIMEOUT_SECONDS=20

# --- Server -----------------------------------------------------------------------------
PORT=4000
# development | test | production
NODE_ENV=development
# Structured JSON log level: debug | info | warn | error (default info).
LOG_LEVEL=info
# Comma-separated allowed origins for the storefront/admin (credentials: true).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Express `trust proxy`: false (no proxy) by default; set to 1 behind one reverse proxy.
TRUST_PROXY=false
PUBLIC_API_URL=http://localhost:4000
STOREFRONT_PUBLIC_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# --- Auth (required) ---------------------------------------------------------------------
# At least 16 characters. Signs both owner and customer sessions (distinguished by
# per-realm iss/aud claims — see src/shared/auth/revocation.ts).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-16-chars
# Owner session lifetime in hours.
SESSION_TTL_HOURS=12
OWNER_EMAIL=owner@yourstore.example
# REQUIRED in production (startup fails without it). Default in dev/test only.
OWNER_PASSWORD=change-me-to-a-strong-password-at-least-8-chars
OWNER_NAME=Store Owner

# --- Live currency rates -----------------------------------------------------------------
# Set to false to disable the 6-hour refresh timer (VPS). On Vercel, set CRON_SECRET and
# Vercel Cron calls /api/settings/cron/currency-rates daily instead.
CURRENCY_AUTO_SYNC=true
# At least 16 characters. Required for the Vercel cron endpoints; the currency cron and
# the push-flush cron both answer 404/401 without it.
CRON_SECRET=change-me-to-a-long-random-secret-at-least-16-chars

# --- Customer sessions -------------------------------------------------------------------
# Customer session lifetime in hours (default 168h = 7 days).
CUSTOMER_SESSION_TTL_HOURS=168

# --- Email (password reset) ---------------------------------------------------------------
# All optional. Without SMTP_HOST + SMTP_USER + SMTP_PASSWORD, reset emails are NOT sent
# (the API still answers { ok: true }); the admin can see this via `smtpConfigured` in
# GET /api/admin/settings. SMTP details are still needed from the store owner.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Your Store" <no-reply@yourstore.example>

# --- Cloudinary (image CDN) ---------------------------------------------------------------
# All three required for Cloudinary uploads; without them images are stored in the DB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments ------------------------------------------------------------------------------
# none | razorpay (Razorpay is the only supported gateway).
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret from Razorpay Dashboard -> Webhooks -> Secret. NOT the API key secret.
# Required for the wallet top-up webhook; until it is set the webhook rejects everything.
RAZORPAY_WEBHOOK_SECRET=

# --- Bank-account encryption ---------------------------------------------------------------
# Optional. BANK_ACCOUNT_KEY must be 64 hex characters (32 bytes) when set; otherwise the
# key is derived from APP_SECRET, else from JWT_SECRET. Never leave a real key here.
BANK_ACCOUNT_KEY=
APP_SECRET=

# --- Firebase Admin (push notifications) ----------------------------------------------------
# All three required to send push. Without them, push is skipped and the inbox still works.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Store wallet ----------------------------------------------------------------------------
# Top-up is disabled by default (false) until the merchant confirms provider support.
# Amounts in INR paise.
WALLET_TOPUP_ENABLED=false
WALLET_TOPUP_MIN_PAISE=10000
WALLET_TOPUP_MAX_PAISE=1000000

# --- Platform (not set in .env) ---------------------------------------------------------------
# VERCEL is set by the Vercel platform itself when running there; it is read directly from
# the runtime environment (exchange-rate scheduler skips its timer on Vercel). Do not set it here.
