{
  "name": "your-store-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Express + PostgreSQL API for the Your Store catalog (milestone 1: products, categories, media, owner auth).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-env.mjs && tsx watch src/server.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "node scripts/check-env.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "db:password": "node scripts/set-db-password.mjs",
    "check:env": "node scripts/check-env.mjs",
    "db:create": "node scripts/create-db.mjs",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "catalog:images": "tsx scripts/import-dignity-images.ts",
    "catalog:fix-categories": "tsx scripts/fix-categories.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "nodemailer": "^6.9.16",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^6.0.3",
    "prisma": "^5.22.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.5"
  }
}
