// Catalog schema: owner auth, categories, products (with options, variants, images,
// specs) and media, plus checkout, orders, coupons, settings, wallet, returns,
// exchanges, refunds and notifications — all backed by Prisma + MySQL.
//
// Money is stored as integer minor units in the USD base currency, matching both apps.
// Localized text is stored as paired `...En` / `...Hi` columns so it can be queried and indexed.
//
// ENGINE: MySQL only (Aiven MySQL in dev; MySQL on the production host). The schema uses
// MySQL-only constructs (DATETIME(3), FULLTEXT, information_schema checks in migrations),
// so do not switch the provider below — PostgreSQL/SQLite are not supported.
//
// MySQL note: Prisma's default native type for `String` is VARCHAR(191) — enough for ids, slugs, SKUs
// and short labels, but too short for descriptions and JSON blobs, which are marked `@db.Text` below.
// The database itself must use utf8mb4 (not latin1/utf8mb3) or Hindi text will not store correctly;
// `npm run db:create` creates it that way.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// The single store owner. This is a single-seller store: there is no vendor or multi-tenant concept.
model Owner {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("owners")
}

/// Uploaded or seeded image. Bytes live in the database so both apps resolve the same durable
/// URL (`/media/:id`) across restarts, with no dependency on a CDN or local blob: URLs.
model Media {
  id        String   @id
  fileName  String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  altEn     String   @default("") @db.Text
  altHi     String   @default("") @db.Text
  /// Raw file bytes — null when the asset is stored on Cloudinary.
  data            Bytes?
  /// Cloudinary secure_url — set for assets uploaded after Cloudinary was wired in.
  cloudinaryUrl   String?  @db.Text
  /// Cloudinary public_id — needed to delete/transform the asset.
  cloudinaryId    String?
  source    String   @default("seed") // 'seed' | 'upload'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryImages      Category[]         @relation("CategoryImage")
  categoryBanners     Category[]         @relation("CategoryBanner")
  productImages       ProductImage[]
  storeLogoFor        StoreSettings[]
  collectionHeroFor   Collection[]
  collectionCircleFor CollectionCircle[]

  @@map("media")
}

model Category {
  id            String   @id
  slug          String   @unique
  nameEn        String
  nameHi        String   @default("")
  descriptionEn String   @default("") @db.Text
  descriptionHi String   @default("") @db.Text
  imageId       String?
  bannerId      String?
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  image    Media?    @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  banner   Media?    @relation("CategoryBanner", fields: [bannerId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([isActive, displayOrder])
  @@map("categories")
}

model Product {
  id                 String   @id
  slug               String   @unique
  /// 'draft' | 'active' | 'archived' (see ProductStatus in src/types.ts)
  status             String   @default("draft")
  nameEn             String
  nameHi             String   @default("")
  /// Lowercase copy of nameEn, so search works case-insensitively on every engine.
  nameSearch         String   @default("")
  shortDescriptionEn String   @default("") @db.Text
  shortDescriptionHi String   @default("") @db.Text
  descriptionEn      String   @default("") @db.Text
  descriptionHi      String   @default("") @db.Text
  categoryId         String
  itemGroupId        String?
  navLinkId          String?
  /// Optional collection this product belongs to (M-P1). No storefront behaviour
  /// changes: collections render their own sections; this is the assignment.
  collectionId       String?
  /// Optional barcode (EAN/UPC/SKU barcode) for stock-taking and POS.
  barcode            String?
  /// Internal cost price in USD minor units (M-P1). NEVER exposed to the storefront
  /// (toStorefrontProduct omits it) or to customers — admin only.
  costPrice          Int?
  /// JSON array of strings.
  tags               String   @default("[]") @db.Text
  /// Lowercase, space-separated haystack of name + tags + SKUs for search.
  searchText         String   @default("") @db.Text
  /// USD minor units.
  basePrice          Int
  baseSalePrice      Int?
  materialsEn        String   @default("") @db.Text
  materialsHi        String   @default("") @db.Text
  careEn             String   @default("") @db.Text
  careHi             String   @default("") @db.Text
  returnsAllowed      Boolean  @default(true)
  exchangeAllowed     Boolean  @default(true)
  returnDays          Int      @default(30)
  weightValue        Float?
  weightUnit         String   @default("g")
  dimLength          Float?
  dimWidth           Float?
  dimHeight          Float?
  dimUnit            String   @default("cm")
  isFeatured         Boolean  @default(false)
  isBestseller       Boolean  @default(false)
  isNew              Boolean  @default(false)
  displayOrder       Int      @default(100)
  seoTitleEn         String   @default("")
  seoTitleHi         String   @default("")
  seoDescriptionEn   String   @default("") @db.Text
  seoDescriptionHi   String   @default("") @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category     Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  itemGroup    ItemGroup?       @relation(fields: [itemGroupId], references: [id], onDelete: SetNull)
  navLink      NavLink?         @relation(fields: [navLinkId], references: [id], onDelete: SetNull)
  collection   Collection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  options      ProductOption[]
  variants     ProductVariant[]
  specs        ProductSpec[]
  wishlistedBy WishlistItem[]
  reviews      Review[]

  @@index([status, displayOrder])
  @@index([categoryId])
  @@index([itemGroupId])
  @@index([navLinkId])
  @@index([collectionId])
  @@fulltext([searchText])
  @@map("products")
}

/// Ordered product gallery. `position` 0 is the primary image.
model ProductImage {
  id        String @id @default(cuid())
  productId String
  mediaId   String
  position  Int
  altEn     String @default("")
  altHi     String @default("")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([productId, position])
  @@map("product_images")
}

model ProductOption {
  id        String @id
  productId String
  nameEn    String
  nameHi    String @default("")
  /// 'swatch' | 'button'
  type      String @default("button")
  position  Int

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId, position])
  @@map("product_options")
}

model ProductOptionValue {
  id       String  @id
  optionId String
  labelEn  String
  labelHi  String  @default("")
  swatch   String?
  position Int

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([optionId, position])
  @@map("product_option_values")
}

model ProductVariant {
  id        String @id
  productId String
  sku       String @unique
  /// JSON object: optionId -> valueId. "{}" for products without options.
  options   String @default("{}") @db.Text
  /// USD minor units.
  price     Int
  salePrice Int?
  stock     Int    @default(0)
  /// JSON array of media ids shown when this variant is selected.
  imageIds  String @default("[]") @db.Text
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_variants")
}

model ProductSpec {
  id        String @id
  productId String
  labelEn   String
  labelHi   String @default("")
  valueEn   String
  valueHi   String @default("")
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_specs")
}

// ---------------------------------------------------------------------------------------------
// Milestone 2: settings, inventory history, homepage/page content, coupons, customers, orders.
// Singleton config tables use a fixed id of "singleton", enforced at the application layer (never
// created twice), the same way every other single-seller invariant in this schema is enforced.
// ---------------------------------------------------------------------------------------------

model StoreSettings {
  id                String   @id @default("singleton")
  nameEn            String   @default("Your Store")
  taglineEn         String   @default("") @db.Text
  taglineHi         String   @default("") @db.Text
  logoId            String?
  contactEmail      String   @default("")
  contactPhone      String   @default("")
  contactAddress    String   @default("") @db.Text
  contactHoursEn    String   @default("") @db.Text
  contactHoursHi    String   @default("") @db.Text
  socialInstagram   String   @default("")
  socialPinterest   String   @default("")
  socialFacebook    String   @default("")
  socialYoutube     String   @default("")
  handlingMinDays   Int      @default(1)
  handlingMaxDays   Int      @default(3)
  maxQtyPerLine     Int      @default(10)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  logo Media? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@map("store_settings")
}

model ShippingSettings {
  id                   String   @id @default("singleton")
  unsupportedMessageEn String   @default("We don't currently ship to this destination.") @db.Text
  unsupportedMessageHi String   @default("") @db.Text
  /// Free-shipping order-value threshold in USD minor units (M-S2). Null = no
  /// threshold (shipping is always charged per the zone rate). When set, an order
  /// whose goods subtotal (after discounts, before shipping/tax) reaches this value
  /// ships free in every zone.
  freeShippingThreshold Int?
  updatedAt            DateTime @updatedAt

  zones ShippingZone[]

  @@map("shipping_settings")
}

model ShippingZone {
  id              String  @id @default(cuid())
  settingsId      String  @default("singleton")
  nameEn          String
  /// JSON array of ISO-3166 alpha-2 country codes.
  countries       String  @default("[]") @db.Text
  standardEnabled Boolean @default(true)
  standardRate    Int     @default(0)
  standardMinDays Int     @default(3)
  standardMaxDays Int     @default(6)
  expressEnabled  Boolean @default(false)
  expressRate     Int     @default(0)
  expressMinDays  Int     @default(1)
  expressMaxDays  Int     @default(3)
  position        Int     @default(0)

  settings ShippingSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId, position])
  @@map("shipping_zones")
}

model TaxSettings {
  id               String   @id @default("singleton")
  pricesIncludeTax Boolean  @default(false)
  defaultRate      Float    @default(0)
  updatedAt        DateTime @updatedAt

  rules TaxRule[]

  @@map("tax_settings")
}

model TaxRule {
  id         String @id @default(cuid())
  settingsId String @default("singleton")
  country    String
  region     String @default("")
  rate       Float
  label      String

  settings TaxSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, country, region])
  @@map("tax_rules")
}

model CurrencySettings {
  id             String   @id @default("singleton")
  base           String   @default("USD")
  ratesUpdatedAt DateTime @default(now())
  /// Last time the live-rate sync ran (success or failure); null = never.
  autoSyncAt     DateTime?
  /// Empty when the last sync succeeded; otherwise a short reason it failed.
  autoSyncError  String   @default("") @db.Text
  updatedAt      DateTime @updatedAt

  currencies CurrencyConfig[]

  @@map("currency_settings")
}

model CurrencyConfig {
  id                String  @id @default(cuid())
  settingsId        String  @default("singleton")
  code              String
  name              String
  enabled           Boolean @default(true)
  rate              Float
  /// true = the rate is refreshed from a live exchange-rate feed; false = typed in by hand.
  autoRate          Boolean @default(false)
  fractionDigits    Int     @default(2)
  roundingIncrement Int     @default(1)

  settings CurrencySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, code])
  @@map("currency_configs")
}

model LanguageSettings {
  id              String   @id @default("singleton")
  defaultLanguage String   @default("en")
  hindiEnabled    Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@map("language_settings")
}

/// Stock adjustment log. Fields are a denormalized snapshot at the time of the adjustment (not FKed
/// to the product/variant), so history survives a later product edit, archive, or variant rebuild —
/// the same product-edit path rewrites variant rows (delete + recreate) on every save, which would
/// otherwise cascade-delete this history on an unrelated field edit.
model InventoryAdjustment {
  id            String   @id @default(cuid())
  productId     String
  variantId     String
  sku           String
  productNameEn String
  productNameHi String   @default("")
  variantLabel  String   @default("")
  before        Int
  after         Int
  delta         Int
  /// 'restock' | 'correction' | 'damaged' | 'returned' | 'order_cancelled' | 'other'
  reason        String
  note          String   @default("") @db.Text
  actor         String
  createdAt     DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([productId])
  @@map("inventory_adjustments")
}

model HomepageContent {
  id            String    @id @default("singleton")
  /// Full HomepageContent JSON (see admin/frontend types) — nested and never queried relationally.
  draftJson     String    @db.Text
  publishedJson String?   @db.Text
  publishedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  updatedBy     String    @default("")

  @@map("homepage_content")
}

model PageDoc {
  /// 'about' | 'contact' | 'faq' | 'shipping' | 'returns' | 'privacy' | 'terms' — the 7 fixed keys.
  key           String    @id
  isLegal       Boolean   @default(false)
  draftJson     String    @db.Text
  publishedJson String?   @db.Text
  publishedAt   DateTime?
  updatedAt     DateTime  @updatedAt
  updatedBy     String    @default("")

  @@map("page_docs")
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String    @default("") @db.Text
  /// 'percentage' | 'fixed'
  type             String
  /// Percentage points (0-100) or fixed USD minor units, depending on `type`.
  value            Float
  maxDiscount      Int?
  minOrder         Int?
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean   @default(true)
  usageLimit       Int?
  perCustomerLimit Int?
  timesUsed        Int       @default(0)
  /// 'all' | 'products' | 'categories'
  scope            String    @default("all")
  productIds       String    @default("[]") @db.Text
  categoryIds      String    @default("[]") @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  redemptions CouponRedemption[]

  @@map("coupons")
}

/// One row per successful redemption, so `perCustomerLimit` can be enforced under concurrent
/// checkouts via a conditional insert inside the same transaction that increments `timesUsed`.
model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  /// "acct:<customerId>" for signed-in customers, "guest:<lowercased email>" otherwise.
  customerKey String
  orderId     String
  createdAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, customerKey])
  @@map("coupon_redemptions")
}

model Customer {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String   @default("")
  avatarUrl    String?
  gender       String?
  languages    String?
  occupation   String?
  pincode      String?
  city         String?
  state        String?
  dateOfBirth  String?
  maritalStatus String?
  numberOfKids  String?
  education    String?
  monthlyIncome String?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses          CustomerAddress[]
  wishlistItems      WishlistItem[]
  resetTokens        PasswordResetToken[]
  orders             Order[]
  reviews            Review[]
  fcmTokens          FcmToken[]
  notificationRecords NotificationRecord[]
  walletBalance      WalletBalance?
  walletTransactions WalletTransaction[]
  walletTopups       WalletTopup[]

  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  label        String   @default("Address")
  isDefault    Boolean  @default(false)
  fullName     String
  phoneCountry String   @default("")
  phone        String
  country      String
  line1        String
  line2        String   @default("")
  city         String   @default("")
  region       String   @default("")
  postalCode   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId, variantId])
  @@index([customerId])
  @@map("wishlist_items")
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("password_reset_tokens")
}

/// A placed order. Line items, address and the currency-rate snapshot are copied in at checkout
/// time (not FKed to the live catalog) so an order's historical detail never changes under it.
model Order {
  id                  String    @id @default(cuid())
  number              String    @unique
  /// Client-supplied idempotency key; a retry with the same key returns the original order.
  idempotencyKey      String?   @unique
  customerId          String?
  /// 'account' | 'guest'
  customerKind        String
  customerName        String
  customerEmail       String
  customerPhone       String    @default("")
  /// Guest orders only: sha256 of a one-time-issued random access token (never the raw token), the
  /// guest's only way back into GET /api/orders/:id after checkout. Null for account orders, which are
  /// authorized by the signed-in customer's session instead.
  guestTokenHash      String?   @unique
  guestTokenExpiresAt DateTime?
  /// JSON Address object.
  shippingAddressJson String    @db.Text
  currency            String
  /// JSON RateSnapshot { base, currency, rate, capturedAt }.
  rateSnapshotJson    String    @db.Text
  subtotal            Int
  discount            Int       @default(0)
  couponCode          String?
  shipping            Int       @default(0)
  tax                 Int       @default(0)
  taxRate             Float     @default(0)
  taxInclusive        Boolean   @default(false)
  total               Int
  refundedTotal       Int       @default(0)
  shippingMethodId    String
  shippingMethodLabel String
  shippingMinDays     Int
  shippingMaxDays     Int
  /// 'card' | 'upi' | 'wallet' (rows placed before Cash on Delivery was removed may still carry 'cod')
  paymentMethod       String
  /// 'unpaid' | 'paid' | 'failed' | 'partially_refunded' | 'refunded'
  paymentStatus       String    @default("unpaid")
  /// Razorpay order id for this order's gateway charge (null for full-wallet orders).
  razorpayOrderId     String?   @db.VarChar(255)
  /// Razorpay payment id for this order's gateway charge — the refund/reconciliation
  /// key. Null for full-wallet orders. UNIQUE: one gateway payment can fund at most
  /// one order, so a retried place-order with the same payment id replays instead of
  /// creating a second paid order. (Legacy rows created before this column existed
  /// carry NULL; the old "" default is migrated to NULL.)
  paymentReference    String?   @db.VarChar(255)
  /// 'unfulfilled' | 'processing' | 'shipped' | 'delivered' | 'cancelled'
  fulfilmentStatus    String    @default("unfulfilled")
  carrier             String?
  trackingNumber      String?
  trackingUrl         String?
  restocked           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines       OrderLine[]
  events      OrderEvent[]
  notes       OrderNote[]
  redemptions CouponRedemption[]
  reviews     Review[]

  @@index([customerId])
  @@index([customerEmail])
  @@index([createdAt])
  @@index([fulfilmentStatus])
  @@index([razorpayOrderId])
  @@unique([paymentReference])
  @@map("orders")
}

model OrderLine {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  /// Product slug at the time of order, for the storefront's "view product" link.
  slug           String @default("")
  sku            String
  nameEn         String
  nameHi         String @default("")
  variantLabelEn String @default("")
  variantLabelHi String @default("")
  imageUrl       String @default("") @db.Text
  unitPrice      Int
  quantity       Int
  lineTotal      Int
  /// Units of this line cancelled by the customer (paid lines refund on cancel).
  cancelledQty      Int       @default(0) @map("cancelled_qty")
  /// Units of this line returned and accepted after delivery.
  returnedQty       Int       @default(0) @map("returned_qty")
  /// Units of this line swapped out by an exchange.
  exchangedQty      Int       @default(0) @map("exchanged_qty")
  /// When this line was delivered (set when the order advances to delivered); the
  /// return window is measured from here, never from order.updatedAt.
  deliveredAt       DateTime? @map("delivered_at")
  /// Per-line return-window override in days (null = product.returnDays, else 7).
  returnWindowDays  Int?      @map("return_window_days")
  /// Return shipping fee charged for this line, in the order currency's minor units.
  returnShippingFee Int       @default(0) @map("return_shipping_fee")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_lines")
}

model OrderEvent {
  id      String   @id @default(cuid())
  orderId String
  /// 'created' | 'payment' | 'fulfilment' | 'tracking' | 'refund' | 'cancelled' | 'restock' | 'note'
  type    String
  message String   @db.Text
  /// 'system' | 'customer' | 'admin'
  actor   String
  at      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, at])
  @@map("order_events")
}

model OrderNote {
  id      String   @id @default(cuid())
  orderId String
  author  String
  body    String   @db.Text
  at      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_notes")
}

// ---------------------------------------------------------------------------------------------
// Site navigation + curated collections (distinct from Category: a Collection is an admin-curated
// landing page — hero, circular links, several named product sections — a product/category can
// appear in many collections, unlike the catalog's single-category-per-product model).
// ---------------------------------------------------------------------------------------------

model NavLink {
  id        String   @id @default(cuid())
  labelEn   String
  labelHi   String   @default("")
  /// A site path ("/collection/wedding-guide", "/category/ceramics") or a full https:// URL.
  href      String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]

  @@map("nav_links")
}

model ItemGroup {
  id        String    @id @default(cuid())
  nameEn    String
  nameHi    String    @default("")
  slug      String    @unique
  position  Int       @default(100)
  isActive  Boolean   @default(true)
  imageId   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@index([isActive, position])
  @@map("item_groups")
}

model Collection {
  id            String    @id @default(cuid())
  slug          String    @unique
  titleEn       String
  titleHi       String    @default("")
  subtitleEn    String    @default("") @db.Text
  subtitleHi    String    @default("") @db.Text
  descriptionEn String    @default("") @db.Text
  descriptionHi String    @default("") @db.Text
  heroImageId   String?
  /// Hex background behind the hero when no image is set (or alongside it).
  heroColor     String    @default("#F5ECE1")
  /// 'draft' | 'published'
  status        String    @default("draft")
  displayOrder  Int       @default(0)
  showInNavigation Boolean @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  heroImage Media?              @relation(fields: [heroImageId], references: [id], onDelete: SetNull)
  circles   CollectionCircle[]
  sections  CollectionSection[]
  products  Product[]

  @@index([status, displayOrder])
  @@map("collections")
}

/// Circular image links shown under a collection's hero (to a category, another collection, or an
/// arbitrary URL).
model CollectionCircle {
  id           String  @id @default(cuid())
  collectionId String
  labelEn      String
  labelHi      String  @default("")
  imageId      String?
  /// 'category' | 'collection' | 'url'
  linkType     String
  /// A category slug, a collection slug, or a full URL/path, depending on linkType.
  linkValue    String
  position     Int     @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  image      Media?     @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([collectionId, position])
  @@map("collection_circles")
}

/// One named, ordered product shelf within a collection page (e.g. "Winter Wedding").
model CollectionSection {
  id           String @id @default(cuid())
  collectionId String
  titleEn      String
  titleHi      String @default("")
  position     Int    @default(0)
  /// JSON array of product ids, in display order.
  productIds   String @default("[]") @db.Text

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, position])
  @@map("collection_sections")
}

/// A customer's verified-purchase review of a product. One review per (customer, product), enforced
/// by the unique constraint below (not just application logic). Eligibility (a delivered order
/// containing this product) is verified server-side at creation and the qualifying order is recorded;
/// the order itself is never exposed in public review responses.
model Review {
  id         String    @id @default(cuid())
  productId  String
  customerId String
  orderId    String
  rating     Int
  title      String?   @db.VarChar(120)
  body       String?   @db.Text
  /// JSON string[] of customer-uploaded review photo URLs.
  photos     String    @default("[]") @db.Text
  /// 'published' | 'hidden' — set by owner moderation. New reviews publish immediately; hiding/
  /// restoring never rewrites the customer's original rating/title/body.
  status     String    @default("published")
  /// Set only when the customer edits their own review — moderation never touches it.
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  product          Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer         Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order            Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  moderationEvents ReviewModerationEvent[]

  @@unique([customerId, productId])
  @@index([productId, status])
  @@index([status])
  @@map("reviews")
}

/// Append-only moderation log — every hide/restore action, with the owner's reason, so a review's full
/// moderation history survives even across repeated hide/restore cycles.
model ReviewModerationEvent {
  id        String   @id @default(cuid())
  reviewId  String
  /// 'hidden' | 'restored'
  action    String
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_moderation_events")
}

/// Translation memory for store content. Keyed by the exact English source text (via its sha256), so
/// a translation applies wherever that English string appears (product, page, banner, nav…). If the
/// owner edits the English text, the new text has no entry yet and the storefront shows English
/// instead of a stale translation.
model ContentTranslation {
  id         String   @id @default(cuid())
  /// 'de' | 'fr' | 'it' | 'es'
  lang       String   @db.VarChar(8)
  sourceHash String   @db.Char(64)
  source     String   @db.Text
  text       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([lang, sourceHash])
  @@map("content_translations")
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(100)
  email       String   @db.VarChar(200)
  subject     String   @db.VarChar(50)
  orderNumber String   @default("") @db.VarChar(30)
  message     String   @db.Text
  status      String   @default("unread") @db.VarChar(20) // unread | read | replied
  note        String?  @db.Text // internal admin note
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------------------------
// Newsletter subscribers — footer signup (POST /api/newsletter). One row per email; a repeat
// signup for the same email is a no-op success, never an error.
// ---------------------------------------------------------------------------------------------

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique @db.VarChar(200)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

// ---------------------------------------------------------------------------------------------
// Firebase push tokens — one row per registered device/browser.
// ---------------------------------------------------------------------------------------------

model FcmToken {
  id         String   @id @default(cuid())
  customerId String
  token      String   @unique @db.VarChar(512)
  /// Short UA snippet (browser + OS) for display in admin token list.
  deviceInfo String   @default("") @db.VarChar(255)
  lastSeen   DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("fcm_tokens")
}

/// Persistent in-app notification inbox record. Created for both owner ('owner') and customers.
model NotificationRecord {
  id          String    @id @default(cuid())
  /// 'owner' or a customer id.
  recipientId String    @db.VarChar(191)
  /// 'customer' | 'owner'
  kind        String    @db.VarChar(20)
  /// Event type key e.g. 'order.placed', 'wallet.topped_up'.
  event       String    @db.VarChar(100)
  title       String    @db.VarChar(255)
  body        String    @db.Text
  /// Relative path for deep link, e.g. '/account/orders/abc'.
  link        String    @default("") @db.VarChar(512)
  readAt      DateTime?
  /// 'pending' | 'sent' | 'failed' | 'skipped'
  pushStatus  String    @default("pending") @db.VarChar(20)
  pushSentAt  DateTime?
  createdAt   DateTime  @default(now())

  /// Set only for kind='customer' notifications; null for kind='owner'.
  customerId String?   @db.VarChar(191)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([event])
  @@map("notification_records")
}

/// Log of admin-initiated broadcast or targeted sends.
model NotificationSend {
  id            String   @id @default(cuid())
  /// Always 'owner' for now.
  senderId      String   @db.VarChar(191)
  /// 'one' | 'all'
  recipientType String   @db.VarChar(10)
  /// Set for 'one' sends; null for broadcast.
  recipientId   String?  @db.VarChar(191)
  title         String   @db.VarChar(255)
  body          String   @db.Text
  sentAt        DateTime @default(now())
  successCount  Int      @default(0)
  failCount     Int      @default(0)

  @@index([sentAt])
  @@map("notification_sends")
}

// ---------------------------------------------------------------------------------------------
// Store Wallet — INR-only balance for signed-in customers.
// ---------------------------------------------------------------------------------------------

/// One row per customer. Created on first top-up or refund credit.
model WalletBalance {
  customerId    String   @id
  /// Balance in USD cents (base currency minor units). Never negative.
  balanceMinor  Int      @default(0)
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@map("wallet_balances")
}

/// Append-only ledger. Every credit and debit gets its own row.
model WalletTransaction {
  id           String   @id @default(cuid())
  customerId   String
  /// 'topup' | 'spend' | 'refund' | 'reversal'
  type         String   @db.VarChar(20)
  /// Positive = credit, negative = debit. Always in USD cents (base currency).
  amountMinor  Int
  balanceAfter Int
  /// Idempotency key — unique per business event.
  reference    String   @unique @db.VarChar(191)
  /// Linked order id for 'spend' and 'refund' types.
  orderId      String?  @db.VarChar(191)
  /// Linked WalletTopup id for 'topup' type.
  topupId      String?  @db.VarChar(191)
  note         String?  @db.Text
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("wallet_transactions")
}

/// Razorpay order created for a wallet top-up. Credited only after verified capture.
model WalletTopup {
  id                String    @id @default(cuid())
  customerId        String
  /// Amount customer paid in their display currency minor units (e.g. USD cents, INR paise).
  amountMinor       Int
  /// ISO 4217 currency code the customer paid in (e.g. "USD", "INR").
  currency          String    @default("USD") @db.VarChar(10)
  razorpayOrderId   String    @unique @db.VarChar(255)
  razorpayPaymentId String?   @db.VarChar(255)
  /// 'pending' | 'paid' | 'failed'
  status            String    @default("pending") @db.VarChar(20)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@map("wallet_topups")
}

// ---------------------------------------------------------------------------------------------
// Returns, exchanges & refunds — real Prisma models since the 20261121010000 migration.
// The tables were previously created by one-shot scripts (migrate-returns.ts /
// migrate-exchanges.ts, now deleted); the migration creates the same tables with
// CREATE TABLE IF NOT EXISTS, so existing dev databases keep their data.
// These models deliberately carry NO relations: returns/exchanges/refunds reference
// orders/lines by id only, so deleting an order never cascades into refund history.
// ---------------------------------------------------------------------------------------------

/// A customer return request for one order line.
/// 'requested' | 'approved' | 'rejected' | 'shipping_arranged' | 'in_transit' | 'received' | 'inspected' | 'refunded' | 'withdrawn' | 'closed'
model ReturnRequest {
  id                  String    @id @default(cuid()) @map("id")
  reference           String    @unique @db.VarChar(191) @map("reference")
  orderId             String    @db.VarChar(191) @map("order_id")
  orderLineId         String    @db.VarChar(191) @map("order_line_id")
  variantId           String    @db.VarChar(191) @map("variant_id")
  requestedQty        Int @map("requested_qty")
  approvedQty         Int? @map("approved_qty")
  receivedQty         Int? @map("received_qty")
  acceptedQty         Int? @map("accepted_qty")
  restockQty          Int? @map("restock_qty")
  /// damaged | wrong_item | not_as_described | changed_mind | quality_issue | other
  reason              String    @db.VarChar(191) @map("reason")
  customerNote        String?   @db.Text @map("customer_note")
  adminNote           String?   @db.Text @map("admin_note")
  rejectionReason     String?   @db.Text @map("rejection_reason")
  /// JSON string[] of photo URLs.
  photos              String?   @db.Text @map("photos")
  status              String    @default("requested") @db.VarChar(50) @map("status")
  /// self_ship | pickup
  shippingMethod      String?   @db.VarChar(50) @map("shipping_method")
  customerCarrier     String?   @db.VarChar(191) @map("customer_carrier")
  customerTracking    String?   @db.VarChar(191) @map("customer_tracking")
  pickupAddress       String?   @db.Text @map("pickup_address")
  returnCarrier       String?   @db.VarChar(191) @map("return_carrier")
  returnTracking      String?   @db.VarChar(191) @map("return_tracking")
  refundableAmount    Int       @default(0) @map("refundable_amount")
  shippingFee         Int       @default(0) @map("shipping_fee")
  refundAmount        Int? @map("refund_amount")
  returnWindowDays    Int       @default(7) @map("return_window_days")
  /// Bank account / UPI id chosen for a manual refund (see refund_method_override).
  refundAccountId     String?   @db.VarChar(191) @map("refund_account_id")
  refundMethodOverride String?  @db.VarChar(50) @map("refund_method_override")
  requestedAt         DateTime  @default(now()) @map("requested_at")
  decidedAt           DateTime? @map("decided_at")
  receivedAt          DateTime? @map("received_at")
  inspectedAt         DateTime? @map("inspected_at")
  refundedAt          DateTime? @map("refunded_at")

  @@index([orderId])
  @@index([status])
  @@map("return_requests")
}

/// Timeline events for a return request.
model ReturnEvent {
  id        String   @id @default(cuid()) @map("id")
  returnId  String   @db.VarChar(191) @map("return_id")
  /// requested | approved | rejected | pickup_arranged | in_transit | received | inspected | refunded | withdrawn | refund_issued | note
  type      String   @db.VarChar(100) @map("type")
  /// customer | admin | system
  actor     String   @db.VarChar(50) @map("actor")
  actorId   String?  @db.VarChar(191) @map("actor_id")
  message   String?  @db.Text @map("message")
  data      String?  @db.Text @map("data")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([returnId])
  @@map("return_events")
}

/// One money movement back to a customer. 'original' = back to the gateway payment
/// method (Razorpay refund); 'manual_bank' / 'manual_upi' = owner transfers the money
/// and marks it completed with proof; 'store_credit' = wallet credit.
/// 'pending' | 'processing' | 'completed' | 'failed'
model Refund {
  id          String    @id @default(cuid()) @map("id")
  orderId     String    @db.VarChar(191) @map("order_id")
  /// Null for direct admin refunds not tied to a return.
  returnId    String?   @unique @db.VarChar(191) @map("return_id")
  amount      Int @map("amount")
  reason      String    @db.Text @map("reason")
  method      String    @default("original") @db.VarChar(50) @map("method")
  status      String    @default("pending") @db.VarChar(50) @map("status")
  /// Gateway refund id (Razorpay) or the manual transfer reference.
  reference   String?   @db.VarChar(191) @map("reference")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")
  /// Admin email that recorded the refund.
  recordedBy  String?   @db.VarChar(191) @map("recorded_by")
  note        String?   @db.Text @map("note")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("refunds")
}

/// A customer exchange request: swap one order line's variant for another.
/// 'requested' | 'approved' | 'rejected' | 'shipped' | 'delivered' | 'closed'
model ExchangeRequest {
  id                   String    @id @default(cuid()) @map("id")
  reference            String    @unique @db.VarChar(191) @map("reference")
  orderId              String    @db.VarChar(191) @map("order_id")
  orderLineId          String    @db.VarChar(191) @map("order_line_id")
  originalVariantId    String    @db.VarChar(191) @map("original_variant_id")
  replacementVariantId String    @db.VarChar(191) @map("replacement_variant_id")
  requestedQty         Int @map("requested_qty")
  approvedQty          Int? @map("approved_qty")
  reason               String    @db.VarChar(191) @map("reason")
  customerNote         String?   @db.Text @map("customer_note")
  adminNote            String?   @db.Text @map("admin_note")
  rejectionReason      String?   @db.Text @map("rejection_reason")
  status               String    @default("requested") @db.VarChar(50) @map("status")
  /// Replacement price minus original line price, in the ORDER currency's minor
  /// units (converted prices on both sides — never USD-base vs converted). Positive
  /// = customer owes the difference; negative = customer is refunded it.
  priceDifference      Int       @default(0) @map("price_difference")
  exchangeWindowDays   Int       @default(7) @map("exchange_window_days")
  replacementCarrier   String?   @db.VarChar(191) @map("replacement_carrier")
  replacementTracking  String?   @db.VarChar(191) @map("replacement_tracking")
  requestedAt          DateTime  @default(now()) @map("requested_at")
  decidedAt            DateTime? @map("decided_at")
  shippedAt            DateTime? @map("shipped_at")
  deliveredAt          DateTime? @map("delivered_at")
  closedAt             DateTime? @map("closed_at")

  @@index([orderId])
  @@index([orderLineId])
  @@index([status])
  @@map("exchange_requests")
}

/// Timeline events for an exchange request.
model ExchangeEvent {
  id         String   @id @default(cuid()) @map("id")
  exchangeId String   @db.VarChar(191) @map("exchange_id")
  /// requested | approved | rejected | shipped | delivered | closed | payment_recorded | refund_issued | original_restocked | note
  type       String   @db.VarChar(100) @map("type")
  /// customer | admin | system
  actor      String   @db.VarChar(50) @map("actor")
  actorId    String?  @db.VarChar(191) @map("actor_id")
  message    String?  @db.Text @map("message")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([exchangeId])
  @@map("exchange_events")
}

/// A customer's saved bank account for manual refunds. The account number is stored
/// AES-256-GCM encrypted (see bank-account.crypto.ts); only the last 4 digits are
/// ever readable without the key.
model CustomerBankAccount {
  id                     String   @id @default(cuid()) @map("id")
  customerId             String   @db.VarChar(191) @map("customer_id")
  accountHolderName      String   @db.VarChar(255) @map("account_holder_name")
  accountNumberEncrypted String   @db.Text @map("account_number_encrypted")
  accountNumberLast4     String   @db.Char(4) @map("account_number_last4")
  ifscCode               String   @db.VarChar(11) @map("ifsc_code")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_bank_accounts")
}

/// A short-lived stock reservation created when a Razorpay order is created at
/// checkout, so the last unit cannot be sold twice while the customer is in the
/// Razorpay modal. Consumed (deleted) when placeOrder succeeds; expired rows are
/// swept on every create-order call and never block stock past `expiresAt`.
/// Stock availability checks subtract unexpired holds.
model StockHold {
  id              String   @id @default(cuid())
  variantId       String   @db.VarChar(191)
  quantity        Int
  razorpayOrderId String   @db.VarChar(255)
  customerKey     String?  @db.VarChar(191)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([razorpayOrderId, variantId])
  @@index([variantId, expiresAt])
  @@map("stock_holds")
}

/// Revoked JWTs (logout / password change). Only the sha256 of the token id is
/// stored; rows are swept once expired. Checked by both auth middlewares.
model RevokedSession {
  id        String   @id @default(cuid())
  jtiHash   String   @unique @db.VarChar(64)
  /// 'owner' | 'customer'
  realm     String   @db.VarChar(20)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_sessions")
}

/// A Razorpay order created at checkout (L4). The row binds the gateway order to the
/// server-computed amount/currency and to the requester, and the receipt is always
/// the idempotency key (server-derived, never client-supplied), so a later
/// placeOrder can only ever match the order created for the same checkout attempt.
model RazorpayOrder {
  id              String   @id @default(cuid())
  razorpayOrderId String   @unique @db.VarChar(255)
  amount          Int
  currency        String   @db.VarChar(10)
  receipt         String   @db.VarChar(40)
  customerKey     String?  @db.VarChar(191)
  /// 'created' | 'paid' | 'expired'
  status          String   @default("created") @db.VarChar(20)
  createdAt       DateTime @default(now())

  @@index([customerKey])
  @@map("razorpay_orders")
}
